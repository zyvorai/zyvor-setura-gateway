[Unit]
Description=Setura built-in gateway
Documentation=https://github.com/zyvorai/zyvor-setura-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=setura
ConfigurationDirectory=setura
ExecStart=/usr/bin/setura gateway run --config /etc/setura/gateway.json --bind 127.0.0.1 --admin 127.0.0.1:19000
# The gateway reloads /etc/setura/gateway.json by itself when it changes.
# SIGHUP only reopens a file access log (rotation).
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
# Binding ports below 1024 needs this; the default config does not need it.
#AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
