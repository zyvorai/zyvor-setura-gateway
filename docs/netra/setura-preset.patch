+func TestSeturaPreset(t *testing.T) {
+	var hits atomic.Int64
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		n := hits.Add(1)
+		fmt.Fprintf(w, `# HELP setura_gateway_route_requests_total Requests per route and status class.
+# TYPE setura_gateway_route_requests_total counter
+setura_gateway_route_requests_total{route="shop/web",code="2xx"} %d
+setura_gateway_route_requests_total{route="shop/web",code="5xx"} %d
+# TYPE setura_gateway_circuit_state gauge
+setura_gateway_circuit_state{backend="shop/web:80"} 1
+# TYPE setura_gateway_cert_expiry_seconds gauge
+setura_gateway_cert_expiry_seconds{listener="shop/gw/https"} 864000
+# TYPE setura_gateway_request_duration_seconds histogram
+setura_gateway_request_duration_seconds_bucket{route="shop/web",le="0.1"} 9
+setura_gateway_request_duration_seconds_bucket{route="shop/web",le="+Inf"} 10
+setura_gateway_request_duration_seconds_sum{route="shop/web"} %d
+setura_gateway_request_duration_seconds_count{route="shop/web"} %d
+# TYPE go_goroutines gauge
+go_goroutines 30
+`, 100*n, n, n, 10*n)
+	}))
+	defer srv.Close()
+	c := AppConfig{Kind: "setura", Name: "edge", URL: srv.URL}
+	if err := c.normalize(); err != nil {
+		t.Fatal(err)
+	}
+	got := runApps(t, NewApps(Config{}, []AppConfig{c}, false, time.Second, nil))
+	for k, v := range map[string]float64{
+		"setura.setura_gateway_circuit_state/backend=shop/web:80":          1,
+		"setura.setura_gateway_cert_expiry_seconds/listener=shop/gw/https": 864000,
+		"apps.up/setura/edge": 1,
+	} {
+		if got[k] != v {
+			t.Errorf("%s = %v, want %v", k, got[k], v)
+		}
+	}
+	if got["setura.setura_gateway_route_requests_total/code=5xx,route=shop/web"] <= 0 {
+		t.Errorf("counter rate missing: %v", got)
+	}
+	for k := range got {
+		if strings.Contains(k, "_bucket") || strings.Contains(k, "go_goroutines") {
+			t.Errorf("unexpected series %s", k)
+		}
+	}
+}
