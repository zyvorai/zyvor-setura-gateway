[]byte("# What ingress2gateway produced, with one deliberate drift: /cart now points at\n# the wrong port and /legacy was lost. /status is new and has no Ingress rule.\napiVersion: gateway.networking.k8s.io/v1\nkind: Gateway\nmetadata:\n  name: nginx\n  namespace: demo\nspec:\n  gatewayClassName: envoy\n  listeners:\n    - name: https\n      protocol: HTTPS\n      port: 443\n      hostname: shop.example.test\n      tls:\n        certificateRefs:\n          - name: shop-tls\n---\napiVersion: gateway.networking.k8s.io/v1\nkind: HTTPRoute\nmetadata:\n  name: shop-shop-example-test\n  namespace: demo\nspec:\n  parentRefs:\n    - name: nginx\n  hostnames:\n    - shop.example.test\n  rules:\n    - matches:\n        - path:\n            type: PathPrefix\n            value: /api\n      filters:\n        - type: URLRewrite\n          urlRewrite:\n            path:\n              type: ReplacePrefixMatch\n              replacePrefixMatch: /\n      backendRefs:\n        - name: api\n          port: 8080\n    - matches:\n        - path:\n            type: Exact\n            value: /cart\n      backendRefs:\n        - name: cart\n          port: 9090\n    - matches:\n        - path:\n            type: PathPrefix\n            value: /web\n      backendRefs:\n        - name: web\n          port: 8080\n    - matches:\n        - path:\n            type: PathPrefix\n            value: /status\n      backendRefs:\n        - name: status\n          port: 8080\n---\napiVersion: gateway.networking.k8s.io/v1\nkind: GRPCRoute\nmetadata:\n  name: rpc-rpc-example-test\n  namespace: demo\nspec:\n  parentRefs:\n    - name: nginx\n  hostnames:\n    - rpc.example.test\n  rules:\n    - matches:\n        - method:\n            service: helloworld.Greeter\n      backendRefs:\n        - name: greeter\n          port: 50051\n    # Header-restricted: the Ingress has no such rule, so this one is extra.\n    - matches:\n        - method:\n            service: helloworld.Greeter\n            method: SayHello\n          headers:\n            - name: x-tenant\n              value: beta\n      backendRefs:\n        - name: greeter\n          port: 50051\n---\n# A route that sends traffic into another namespace. That needs a\n# ReferenceGrant in \"data\"; objects.yaml has none for it.\napiVersion: gateway.networking.k8s.io/v1\nkind: HTTPRoute\nmetadata:\n  name: reports\n  namespace: demo\nspec:\n  parentRefs:\n    - name: nginx\n  hostnames:\n    - reports.example.test\n  rules:\n    - backendRefs:\n        - name: reports\n          namespace: data\n          port: 8080\n")
