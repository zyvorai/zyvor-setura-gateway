[]byte("# An ingress-nginx Ingress for a small shop, as it runs today.\napiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  name: shop\n  namespace: demo\n  annotations:\n    nginx.ingress.kubernetes.io/rewrite-target: /$2\n    nginx.ingress.kubernetes.io/proxy-body-size: 8m\n    nginx.ingress.kubernetes.io/configuration-snippet: |\n      more_set_headers \"X-Frame-Options: DENY\";\nspec:\n  ingressClassName: nginx\n  tls:\n    - hosts: [shop.example.test]\n      secretName: shop-tls\n  rules:\n    - host: shop.example.test\n      http:\n        paths:\n          - path: /api\n            pathType: Prefix\n            backend:\n              service:\n                name: api\n                port:\n                  number: 8080\n          - path: /cart\n            pathType: Exact\n            backend:\n              service:\n                name: cart\n                port:\n                  number: 8080\n          - path: /legacy\n            pathType: Prefix\n            backend:\n              service:\n                name: legacy\n                port:\n                  number: 80\n          # A named port: resolved against the Service in services.yaml.\n          - path: /web\n            pathType: Prefix\n            backend:\n              service:\n                name: web\n                port:\n                  name: http\n---\n# gRPC backend: converts to a GRPCRoute.\napiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  name: rpc\n  namespace: demo\n  annotations:\n    nginx.ingress.kubernetes.io/backend-protocol: \"GRPC\"\nspec:\n  ingressClassName: nginx\n  rules:\n    - host: rpc.example.test\n      http:\n        paths:\n          - path: /helloworld.Greeter\n            pathType: Prefix\n            backend:\n              service:\n                name: greeter\n                port:\n                  number: 50051\n---\n# A different class: skipped with --ingress-class nginx.\napiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  name: admin\n  namespace: demo\nspec:\n  ingressClassName: internal\n  rules:\n    - host: admin.example.test\n      http:\n        paths:\n          - path: /\n            pathType: Prefix\n            backend:\n              service:\n                name: admin\n                port:\n                  number: 80\n")
